# cheqii v2 environment variables. Copy to `.env` and fill in.
# For LOCAL development, run `supabase start` and use the printed URL + publishable key.

# --- Supabase ---
# Local: the "Project URL" + "Publishable" key printed by `supabase start`.
# Cloud: your project's URL + publishable (anon) key.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile ---
# Local/testing: CF's always-passes test site key 1x00000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# gotrue verifies the captcha on anon sign-in ([auth.captcha] secret=env(TURNSTILE_SECRET)).
# `supabase start` auto-loads this file, so the always-passes test SECRET here is
# enough for local guest sign-in.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Google One Tap / OAuth ---
# A real OAuth client ID is required for Google sign-in to work. Any non-empty
# placeholder lets the app boot (sign-in just won't succeed) for local dev.
PUBLIC_GOOGLE_CLIENT_ID=
# Local Supabase Google provider (config.toml [auth.external.google], auto-loaded
# from this file). To make Google sign-in work against the LOCAL stack:
#   1. Set these to a real OAuth client (GOOGLE_CLIENT_ID may reuse PUBLIC_GOOGLE_CLIENT_ID).
#   2. In Google Cloud console, add this redirect URI to that OAuth client:
#        http://127.0.0.1:54321/auth/v1/callback
# Leaving the secret as a placeholder is fine — the app boots and guest sign-in
# works; only Google sign-in fails until a real secret is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ed25519 signing keypair (base64 DER) used by src/lib/utils/common/hash.ts ---
# Generate a local pair:
#   openssl genpkey -algorithm ed25519 -out k.pem
#   PRIVATE_SERVER_KEY = openssl pkey -in k.pem -outform DER | base64 -w0
#   PUBLIC_SERVER_KEY  = openssl pkey -in k.pem -pubout -outform DER | base64 -w0
PRIVATE_SERVER_KEY=
PUBLIC_SERVER_KEY=

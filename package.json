{
  "name": "cheqii",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy:local": "vp build && vp preview",
    "deploy:remote": "vp build && vp exec wrangler deploy && vp exec wrangler tail",
    "dev": "vp dev && supabase start",
    "format": "vp fmt",
    "lint": "vp check",
    "prepare": "vp config",
    "test": "vp run test:integration && vp run test:unit",
    "test:integration": "playwright test",
    "test:unit": "vp test --run",
    "types:dev": "vp exec supabase gen types typescript --local > src/lib/utils/models/database.ts",
    "types:prod": "vp exec supabase gen types typescript --project-id vhoftwygqyufxpmidbwo > src/lib/utils/models/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.54.1",
    "svelte-check": "^4.4.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.35",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/google-one-tap": "^1.2.7",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.4",
    "supabase": "^2.83.0",
    "typescript": "^5.7.3",
    "unplugin-icons": "^23.0.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "wrangler": "^4.76.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "workerd"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}

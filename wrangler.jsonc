{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "name": "cheqii",
  // Per-user rate limit for /api/sync (auth spec §3.4): ~300 requests / 60s / user
  // to blunt mutation spam. Binding is absent in local dev, so the endpoint skips it.
  "unsafe": {
    "bindings": [
      {
        "name": "SYNC_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 300, "period": 60 },
      },
    ],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "vars": {
    "PUBLIC_GOOGLE_CLIENT_ID": "602270566063-nk8bm67dkhu7q1qqsn2aat1mdnk0op1t.apps.googleusercontent.com",
    "PUBLIC_SERVER_KEY": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPbZraNB9Dj8lGuPghpKRjEYoZUmMtgZLYW0Cf/7GZ40 cheqii",
    "PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HhHzGnga__Z26SXJDUnf5Q_maK1Wkhv",
    "PUBLIC_SUPABASE_URL": "https://zxzuprburakoegfvlaoj.supabase.co",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAA-OJitqXFjVpwPg",
  },
}
